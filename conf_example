LOG_LEVEL=dev                      # error | info (по умолчанию, = production) | dev
NODERED_ENABLED=true
MODBUS_ENABLED=true


SERVER_PORT=3010
WSR_PORT_IN=9200
WSR_HOST=127.0.0.1                  # интерфейс NodeRED WS (канал без аутентификации); 0.0.0.0 — все, только за файрволом
WSD_PORT_IN=9202

USERS_FILE=./data/users.enc
AUTH_KEY_FILE=./data/auth.key
# AUTH_MASTER_KEY=             # опционально, 64 hex-символа вместо файла

DEVICE_NAME='BMax'
MANAGE_DOOR=false                  # true — управление замком через GPIO (gpioConf.json)


JWT_SECRET=''  # ≥32 символов для production
JWT_EXPIRES=1d
JWT_ISSUER=myhome

AUTH_BCRYPT_ROUNDS=10
AUTH_MIN_PASSWORD_LEN=8
AUTH_LOGIN_MAX_ATTEMPTS=5
AUTH_LOGIN_IP_MAX_ATTEMPTS=20
AUTH_LOGIN_WINDOW_MS=900000
AUTH_LOGIN_LOCK_MS=900000
AUTH_TIMEOUT_MS=60000                 # сколько соединение Dashboard ждёт входа, потом закрывается; 0 — не закрывать
AUTH_STRICT=FALSE
TRUST_PROXY=FALSE

DEFAULT_USER_NAME='poddy'
DEFAULT_USER_PASSWORD='poddyPASS'
DEFAULT_USER_DID='poddy_base'
DEFAULT_USER_LEVEL=1
DEFAULT_USER_SOURCE='PoddyBase'

DATA_DIR='./configData'

MODBUS_DID=igumen # dID совпадающий с dID пользователя Имя файла сохранения данных
MODBUS_DEVICE=pr205 # Наименование modbus устройства
# Карта тегов: $DATA_DIR/modbusMap.json (образец — modbusMap.json в корне проекта)

# ── Modbus RTU (RS-485, modBus/) ───────────────────────────────────────
MODBUS_RTU_ENABLED=false             # true — поднять Master/Slave RTU по MODBUS_RTU_CONF
MODBUS_RTU_CONF=./modBus/modbusConf.json
#MODBUS_ROLE=slave                   # переопределяет "role" из MODBUS_RTU_CONF: master | slave | both

MODBUS_TIMEOUT=3000
MODBUS_RECONNECT_MIN=1000
MODBUS_RECONNECT_MAX=30000
MODBUS_POLL_ERROR_THRESHOLD=5
MODBUS_POLL_MAX_INTERVAL=300000
MODBUS_POLL_BACKOFF_MULTIPLIER=2
MODBUS_DEVICES='[{
    "id":"pr205",
    "host":"192.168.10.5",
    "port":502,
    "unitId":1
    }]'

# ── Видеонаблюдение ────────────────────────────────────────────────────
VIDEO_ENABLED=true
VIDEO_CAMERAS_FILE=                # список камер 1–16 (по умолчанию $DATA_DIR/cameras.json, образец — cameras.example.json)
VIDEO_MOCK_CAMERAS=4               # нет файла камер → он создаётся с N муляжами (0–16, 0 — не создавать); см. docs/cameras.md
# Без файла камер — одна камера из VIDEO_RTSP_URL (прежний режим):
VIDEO_RTSP_URL=                    # rtsp://user:pass@host:554/stream (пароль кодируйте: @ → %40)
VIDEO_DID=                         # dID, которому принадлежит камера (по умолчанию DEFAULT_USER_DID)
VIDEO_MIN_LEVEL=1                  # минимальный уровень пользователя для просмотра

# Снимки для Vue
VIDEO_SNAPSHOT_INTERVAL_MS=5000    # минимум 500
VIDEO_SNAPSHOT_QUALITY=3           # 2 (лучшее) … 31
VIDEO_SNAPSHOT_MAX_WIDTH=640       # 0 — без масштабирования
VIDEO_DECODE_KEYFRAMES_ONLY=false  # true — декодировать только ключевые кадры (меньше CPU, снимки не чаще GOP)

# Сегменты MP4
VIDEO_SEGMENT_DURATION_SEC=600
VIDEO_FRAGMENTED_MP4=true          # читаемые файлы после обрыва питания
VIDEO_TMP_DIR=./tmp/video
VIDEO_TMP_MAX_MB=2048              # лимит локального архива, 0 — без лимита

# Выгрузка и контроль
VIDEO_UPLOAD_INTERVAL_SEC=300
VIDEO_UPLOAD_MIN_AGE_SEC=30
VIDEO_WATCHDOG_SEC=60              # перезапуск ffmpeg, если нет кадров
FFMPEG_PATH=ffmpeg
FFMPEG_EXTRA_ARGS=                 # входные опции ffmpeg (до -i)

# MTS Cloud S3 (без этих параметров выгрузка отключена)
MTS_S3_ENDPOINT=
MTS_S3_REGION=ru-central-1
MTS_S3_BUCKET=
MTS_S3_ACCESS_KEY_ID=
MTS_S3_SECRET_ACCESS_KEY=
MTS_S3_PREFIX=video-archive
MTS_S3_FORCE_PATH_STYLE=true

# ── Оповещения (type: message) ─────────────────────────────────────────
NOTIFY_DEDUP_TTL_MS=30000          # подавление одинаковых сообщений
NOTIFY_HISTORY_SIZE=50             # сколько последних сообщений хранить на dID

# ── Telegram ───────────────────────────────────────────────────────────
TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=                # токен от @BotFather
TELEGRAM_POLL_TIMEOUT_S=25
TELEGRAM_LINK_TTL_MS=600000        # срок жизни кода привязки (10 минут)
TELEGRAM_MAX_INPUT_LEN=1000        # максимум символов во входящем сообщении
TELEGRAM_RATE_PER_MIN=20           # лимит входящих сообщений с одного чата
TELEGRAM_BAD_CODE_LIMIT=5          # неверных кодов до блокировки чата
TELEGRAM_BAD_CODE_LOCK_MS=900000
#TELEGRAM_API_BASE=https://api.telegram.org